#!/usr/bin/env bash
# Refuse any push that would update the protected branch on the remote.
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency: git push --no-verify
set -euo pipefail

protected="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "$protected" ]]; then
    echo "pre-push: pushing to ${protected#refs/heads/} is blocked. Push a branch and open a PR instead." >&2
    exit 1
  fi
done

exit 0
