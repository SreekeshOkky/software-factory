# Copy to .env and fill in. Never commit .env.

# --- Claude Code auth (one of these) ---
# Long-lived token from `claude setup-token` (uses your Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=
# ...or an API key from console.anthropic.com
ANTHROPIC_API_KEY=

# --- Jira (Atlassian Cloud): needed when a repo uses `tracker: { type: jira }` ---
JIRA_BASE_URL=https://your-site.atlassian.net
# Use a dedicated factory account. It needs: browse, transition, comment,
# edit labels, add attachments on the projects in factory.config.yml.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Give agents the Atlassian Rovo MCP server as well (ticket text is always
# passed in the prompt; MCP adds linked issues/comments). Needs an org admin
# to enable API-token auth for Rovo MCP.
JIRA_ROVO_MCP=false
JIRA_ROVO_MCP_URL=https://mcp.atlassian.com/v1/mcp

# --- GitHub: needed when a repo's git URL is on github.com (or `host: { type: github }`) ---
# Token for clone, push and PR creation (fine-grained: contents rw, pull requests rw)
GH_TOKEN=
# Separate bot account token for review comments (GitHub won't let a PR's author
# review their own PR). Falls back to GH_TOKEN, which can still post comments.
GH_REVIEWER_TOKEN=
GIT_AUTHOR_NAME=Software Factory
GIT_AUTHOR_EMAIL=factory@users.noreply.github.com

# --- Backend services (optional, see services/README.md) ---
# Uncomment when a repo needs a stack, e.g. Supabase:
# COMPOSE_FILE=docker-compose.yml:services/supabase.yml

# --- Runtime ---
# Set to true to log what would happen without changing the tracker or the code host.
DRY_RUN=false
